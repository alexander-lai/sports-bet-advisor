# Copy to .env (repo root) and fill in. Never commit .env.

# --- Required -------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/sports_bet_advisor
# Long random string, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
JWT_SECRET=change-me
# https://the-odds-api.com (free tier: 500 credits/month)
ODDS_API_KEY=

# --- Ball Don't Lie -------------------------------------------------
# https://www.balldontlie.io. The API now issues keys; box scores
# (/stats) may require a paid tier. Leave blank to try without one.
BALLDONTLIE_API_KEY=
# Free tier is 5 req/min; paid tiers allow 60+.
BDL_REQUESTS_PER_MINUTE=60

# --- Seasons (start year: 2023 = 2023-24) ---------------------------
SEED_SEASONS=2023,2024,2025
BACKTEST_SEASON=2025
# Defaults to the season in progress (Oct-Jun); override if needed.
# CURRENT_SEASON=2026

# --- Odds caching ---------------------------------------------------
ODDS_CACHE_TTL_MINUTES=180
ODDS_REGIONS=us
PREFERRED_BOOKMAKERS=draftkings,fanduel,betmgm

# --- Bet sizing -----------------------------------------------------
# Stake = bankroll * min(kelly * KELLY_MULTIPLIER, MAX_BET_FRACTION)
KELLY_MULTIPLIER=1.0
MAX_BET_FRACTION=0.05
# Minimum expected profit per $1 for a prop to be recommended
MIN_EXPECTED_VALUE=0.02

# --- Jobs -----------------------------------------------------------
AUTO_SEED=true
ENABLE_SCHEDULER=true
REFRESH_HOUR_UTC=9
NIGHTLY_RETRAIN=false
CORS_ORIGINS=http://localhost:5173
